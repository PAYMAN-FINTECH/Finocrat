{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<DB_SERVER>;Database=<DB_NAME>;User ID=<DB_USER>;Password=<DB_PASSWORD>;"
  },

  "Jwt": {
    "Key": "<REPLACE_WITH_YOUR_JWT_KEY>",
    "Issuer": "FinocratEdu",
    "Audience": "FinocratEduUsers"
  },

  "InstantPay": {
    "X-Ipay-Client-Id": "<INSTANTPAY_CLIENT_ID>",
    "X-Ipay-Client-Secret": "<INSTANTPAY_CLIENT_SECRET>",
    "X-Ipay-Outlet-Id": "<OUTLET_ID>"
  },

  "Cashfree": {
    "ClientId": "<CASHFREE_CLIENT_ID>",
    "ClientSecret": "<CASHFREE_CLIENT_SECRET>"
  },

  "CashfreePG": {
    "ClientId": "<CASHFREE_PG_CLIENT_ID>",
    "ClientSecret": "<CASHFREE_PG_CLIENT_SECRET>",
    "Environment": "PRODUCTION",
    "ApiVersion": "2025-01-01"
  },
  "EmailSettings": {
    "Email": "<EMAIL_ADDRESS>",
    "Password": "<EMAIL_PASSWORD>"
  }
}
